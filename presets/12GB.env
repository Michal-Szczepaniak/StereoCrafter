# VRAM preset for a 12GB card (e.g. RX 6700 XT, RTX 3060 12GB).
#
# CONFIDENCE: measured, not guessed. Every number here was actually run on
# a 12GB card (12868124672 bytes reported by rocm-smi) at max_res=384,
# 1920x1080 source - see conversation history for the individual peak-VRAM
# probes. This is also just the scripts' own hardcoded defaults; this file
# exists mainly as the reference point the 16GB/24GB presets extrapolate
# from, and so `source presets/12GB.env` documents/pins those numbers
# explicitly rather than relying on defaults matching this card forever.
#
# Usage:
#   source presets/12GB.env && ./run_stereo.sh input.mp4

# ---- stage 1 (depth splatting) ----
export CHUNK_SIZE=110       # peak ~12.0GB with CPU_OFFLOAD=None (93% of card - tight
                             # but survived every test this session; resumable via
                             # checkpointing if it ever doesn't)
export WINDOW_SIZE=70
export WINDOW_OVERLAP=25
export CPU_OFFLOAD=None     # ~40% faster denoising than "model"; safe because stage 1
                             # checkpoints every chunk (see RESUME)

# ---- stage 2 (inpainting) ----
# MEASURED on this exact card via --bench_iters against outputs/opening/splat
# (240-frame, 1920x1080 real footage), after the CFG-off/vae-upcast-off/
# chunked-attention-timing fixes landed:
#   TILE_NUM=4, WORK_SCALE=1.0 (old default, full 1080p, all the free wins
#     from Phase 1 but none of Phase 2) -> 59.85 s/output-frame
#   TILE_NUM=1, WORK_SCALE=0.5, AGGRESSIVE_FREE=True -> 14.5 s/output-frame
#     (~4.1x faster than the line above, ~6.3x faster than this card's old
#     92 s/frame baseline) - visually verified: mean abs pixel diff against
#     the WORK_SCALE=1.0 output was 0.097/255, 99.94% of pixels differed by
#     <30/255, and a diff heatmap showed the only visible differences sit on
#     thin high-contrast edges (subtitle text strokes) - consistent with the
#     ~1.2%-of-pixels occlusion mask this whole approach is built around.
# TILE_NUM=1 at WORK_SCALE=1.0 (i.e. no tiling AND full resolution) still
# OOMs on this card - not retested this session, no reason to expect that's
# changed. AGGRESSIVE_FREE=True is what makes TILE_NUM=1/WORK_SCALE=0.5 fit
# without OOM warnings during vae_decode (tested both ways) - worth trying
# False on a run where this ever becomes the bottleneck, but leave it True
# here since it's the actually-verified-stable combination.
export TILE_NUM=1
export DECODE_LATENTS_CHUNK_SIZE=1  # verified: >1 OOMs at full resolution;
                                     # not retested at WORK_SCALE=0.5
export WORK_SCALE=0.5
export AGGRESSIVE_FREE=True

# ---- resumability ----
export RESUME=True
export MAX_RETRIES=3
