# Stage-2 fill-quality preset - the values measured this session against a
# real 1080p splat store (outputs/disp_exclusion_test). Source it AFTER a
# VRAM preset, since it deliberately overrides that preset's stage-2 speed
# settings:
#
#   source presets/24GB-7900xtx-rocm.env
#   source presets/quality-1080p.env
#   ./run_stereo.sh source_video/z/out.mkv
#
# This is the SLOW/GOOD end of the tradeoff. It gives up ~4x from
# WORK_SCALE, ~3x from steps and ~2x from CFG against the speed presets -
# spend it on a short clip you actually want to look at, not a season pass.
#
# Why each value (hole-vs-surrounding detail ratio, 1.00 = matches the real
# image; near-black = fraction of hole pixels the model cratered on):
#
#   WORK_SCALE=1.0        THE one that matters. At 0.5 the holes are 6-12px,
#                         under one latent pixel after the VAE's 8x
#                         downsample, and the model does nothing at all - it
#                         echoes its conditioning and stage 2 is a no-op.
#                         Measured: departs from its conditioning by 103/255
#                         at 1.0 vs 40/255 at 0.5.
#   CLASSICAL_ONLY=False  run_stereo.sh defaults this to True, i.e. no
#                         diffusion at all, output is pure cv2.INPAINT_TELEA.
#   PREFILL_OCCLUSION=False + RESCUE_THRESHOLD=0.25
#                         Together: let the model generate real texture
#                         (0.84) and repair the ~4% of pixels it craters on,
#                         rather than pre-filling the holes and getting a
#                         blurry echo of TELEA (0.36). Net 0.75 with
#                         near-black at 0.08%.
#   NUM_INFERENCE_STEPS=25  measured better than 8; the gain is concentrated
#                         in the holes, ~3x the diffusion time.
#   MIN/MAX_GUIDANCE_SCALE=2.5
#                         CFG had never been evaluated for quality here (the
#                         speed presets pin it at 1.0, which disables it
#                         outright). It is what moves detail 0.36 -> 0.84.
#   TILE_NUM=2            fewer seam blends than 4, and measured cleaner
#                         (0.38% vs 1.68% near-black). Fits 24GB at
#                         FRAMES_CHUNK=23; TILE_NUM=1 OOMs at WORK_SCALE=1.0.
#   FRAMES_CHUNK=23       upstream's own value. 45 OOMs at full resolution.
#
# UNVERIFIED: every number above was measured on ONE chunk of ONE 1080p
# anime clip. Chunk-boundary consistency across a full run was never tested.
export WORK_SCALE=1.0
export CLASSICAL_ONLY=False
export PREFILL_OCCLUSION=False
export RESCUE_THRESHOLD=0.25
export NUM_INFERENCE_STEPS=25
export MIN_GUIDANCE_SCALE=2.5
export MAX_GUIDANCE_SCALE=2.5
export TILE_NUM=2
export FRAMES_CHUNK=23
# WORK_SCALE=1.0 is 4x the pixels per VAE decode call vs the 0.5 these
# presets were measured at, and the temporal decoder's conv3d allocates for
# the whole decode chunk at once - 4 tried to allocate 5.98GiB and OOM'd on
# a 24GB card even though the diffusion itself had just finished fine.
# presets/12GB.env already recorded the rule ">1 OOMs at full resolution";
# it just never applied while WORK_SCALE was 0.5 everywhere.
export DECODE_LATENTS_CHUNK_SIZE=1
# The same OOM showed 4.25GiB reserved-but-unallocated, i.e. allocator
# fragmentation, which is exactly what this reclaims between tiles.
export AGGRESSIVE_FREE=True
