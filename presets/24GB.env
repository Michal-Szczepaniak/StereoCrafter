# VRAM preset for a 24GB CUDA card (e.g. RTX 3090/4090).
#
# CONFIDENCE: measured, on a rented RTX 4090 (24564MiB reported by
# nvidia-smi). Both CHUNK_SIZE and MAX_RES below were smoke-tested with
# PROCESS_LENGTH set to a single outer chunk and peak VRAM read off
# nvidia-smi mid-run:
#   CHUNK_SIZE=420, MAX_RES=768 -> 23044MiB (94% - stable, not climbing, but
#     too little slack for an ~83-chunk unattended run)
#   CHUNK_SIZE=210, MAX_RES=768 -> 22032MiB (90%, ~2.5GB headroom) <- chosen
# Note CHUNK_SIZE has a much smaller effect than you'd expect: halving it
# only recovered ~1GB. That's because at max_res=768, VRAM is dominated by
# the fixed per-window attention/model cost (DepthCrafter's internal window
# is WINDOW_SIZE=70 frames regardless of the outer CHUNK_SIZE), not by how
# many windows get chained into one chunk - don't bother pushing CHUNK_SIZE
# lower for more headroom, it's not where the VRAM is going. If you need
# more margin than this preset gives, drop MAX_RES instead (that's the
# actual VRAM-hungry knob), or enable CPU_OFFLOAD.
#
# MAX_RES=768 itself (vs. the scripts' own 384 default, sized for a 12GB
# ROCm card with no working flash-attention) is the one really worth having
# on a 24GB CUDA card: it's DepthCrafter's internal depth-estimation
# resolution, so it improves actual depth-map detail across the whole video,
# unlike CHUNK_SIZE which only reduces chunk-boundary crossfade seams.
#
# TILE_NUM: DO NOT just lower this for more VRAM headroom on AMD/ROCm
# hardware - see presets/16GB.env's TILE_NUM note for the full explanation.
# Measured on the 12GB dev card: tile_num=2 needs manual chunked-attention
# fallback (chunked_attention.py) to avoid OOM at all on ROCm (no working
# flash/efficient kernel here), and that fallback runs ~9-11x slower per
# chunk than tile_num=4, with real tail-latency spikes (one tile hit 285s
# for a single step). A bigger card doesn't fix this - it's a compute
# scaling problem (attention cost ~ tile_area^2 without a real efficient
# kernel), not a VRAM one.
#
# On NVIDIA/CUDA (this preset's actual target): flash-attention works, so
# chunked_attention.py's slow fallback never triggers (it always tries the
# real kernel first) and lowering TILE_NUM should be a genuine speedup - try
# TILE_NUM=2 or even 1 and compare wall-clock yourself. Left at 4 below
# because it hasn't actually been measured this session (all the testing
# went into CHUNK_SIZE/MAX_RES); matches what NVIDIA users report in
# upstream issues (tile_num=2 fine on 24GB) but treat it as an opportunity,
# not a verified setting.
#
# DECODE_CHUNK_SIZE is a separate, still-unverified guess.
#
# Usage:
#   source presets/24GB.env && ./run_stereo.sh input.mp4

# ---- stage 1 (depth splatting) ----
export CHUNK_SIZE=210       # measured peak 22032MiB/24564MiB with CPU_OFFLOAD=None,
                             # MAX_RES=768 - see header for the 420 vs 210 comparison
export MAX_RES=768          # measured, see header - the real quality win on this card
export WINDOW_SIZE=70       # unchanged - validated for the cross-chunk consistency fix
export WINDOW_OVERLAP=25
export CPU_OFFLOAD=None

# ---- stage 2 (inpainting) ----
export TILE_NUM=4           # untested on CUDA - see header, may be worth lowering
export DECODE_CHUNK_SIZE=4  # unverified guess
export DECODE_LATENTS_CHUNK_SIZE=4

# ---- resumability (leave this on - it's the safety net for the above being wrong) ----
export RESUME=True
export MAX_RETRIES=3
