# Copy this file to telegram.env (gitignored - never committed) and fill in
# real values, directly on whichever machine actually runs run_season.sh.
# Do NOT put real values in this .example file or anywhere else tracked by
# git - telegram.env is the only place they should live.
#
#   cp telegram.env.example telegram.env
#   $EDITOR telegram.env
#
# If telegram.env doesn't exist, run_season.sh just skips notifications
# silently - this is entirely optional.
export TELEGRAM_CHAT_ID='your-chat-id-here'
export TELEGRAM_API_KEY='your-bot-api-key-here'
